# Neon / Supabase Postgres connection string (required for Colab + local)
# Example: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Local Docker alternative (docker compose up -d):
# DATABASE_URL=postgresql://fraud:fraud@localhost:5433/fraud

AUTOENCODER_VERSION=v1.0.0-autoencoder
CLASSIFIER_VERSION=v1.1.0-classifier
